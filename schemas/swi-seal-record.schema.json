{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swi.local/schemas/swi-seal-record.schema.json",
  "title": "SWI Seal Record",
  "description": "Machine-verifiable seal evidence index. Registry SEALED without a valid evidence/ record is rejected by scripts/swi-seal.mjs. This schema does not by itself seal a module.",
  "type": "object",
  "required": [
    "schema_version",
    "module_id",
    "status",
    "source",
    "commit",
    "run",
    "checks",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "module_id": { "type": "string", "pattern": "^M[0-9]{2}$" },
    "status": { "type": "string", "const": "PASS" },
    "source": {
      "type": "object",
      "required": ["repository"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "path": { "type": "string" }
      }
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "run": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "url": { "type": "string" }
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "contract",
        "unit",
        "negative",
        "deterministic",
        "security",
        "reproducible"
      ],
      "additionalProperties": false,
      "properties": {
        "contract": { "const": true },
        "unit": { "const": true },
        "negative": { "const": true },
        "deterministic": { "const": true },
        "security": { "const": true },
        "reproducible": { "const": true }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
