{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swi.local/schemas/formation/swi-formation-path-inventory.schema.json",
  "title": "SWI Formation Path Inventory FM-023-040",
  "description": "Presence of a valid inventory file does not implement any path.",
  "type": "object",
  "required": ["schema_version", "inventory_id", "package_status", "implementation_status", "proof_status", "paths", "five_axes", "non_claims"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "inventory_id": { "type": "string", "const": "FM-023-040" },
    "package_status": { "type": "string", "const": "PROPOSED" },
    "implementation_status": { "type": "string", "const": "NOT_IMPLEMENTED" },
    "proof_status": { "type": "string", "const": "NONE" },
    "seal_status": { "type": "string", "const": "NOT_APPLICABLE" },
    "authorization_status": { "type": "string", "const": "NOT_AUTHORIZED" },
    "execution_status": { "type": "string", "const": "NOT_EXECUTABLE" },
    "placement": { "type": "object" },
    "five_axes": { "type": "array", "minItems": 5, "maxItems": 5 },
    "paths": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "$ref": "https://swi.local/schemas/formation/swi-formation-path-node.schema.json"
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
